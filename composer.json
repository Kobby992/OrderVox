{
	"name": "webbcode/ordervox",
	"description": "Order notifications via WhatsApp for WooCommerce, using the official WhatsApp Cloud API.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Webbcode Studios"
		}
	],
	"require": {
		"php": ">=8.1",
		"giggsey/libphonenumber-for-php-lite": "^9.0"
	},
	"require-dev": {
		"brain/monkey": "^2.6",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"php-stubs/woocommerce-stubs": ">=9.0",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpstan/phpstan": "^2.1",
		"phpunit/phpunit": "^9.6",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"wp-coding-standards/wpcs": "^3.1",
		"yoast/phpunit-polyfills": "^3.0"
	},
	"autoload": {
		"psr-4": {
			"Webbcode\\Ordervox\\": "includes/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Webbcode\\Ordervox\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"analyse": "phpstan analyse --memory-limit=1G",
		"test": "phpunit",
		"prefix-namespaces": "php strauss.phar"
	},
	"extra": {
		"strauss": {
			"target_directory": "vendor-prefixed",
			"namespace_prefix": "Webbcode\\Ordervox\\Vendor\\",
			"classmap_prefix": "Ordervox_Vendor_",
			"constant_prefix": "ORDERVOX_VENDOR_",
			"packages": [
				"giggsey/libphonenumber-for-php-lite"
			],
			"exclude_from_copy": {
				"packages": [
					"symfony/polyfill-mbstring"
				]
			},
			"delete_vendor_packages": false
		}
	},
	"config": {
		"platform": {
			"php": "8.1"
		},
		"sort-packages": true,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
